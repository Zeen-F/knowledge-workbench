{
  "name": "knowledge-workbench",
  "version": "0.1.0-alpha.4",
  "description": "Windows 与 macOS 模拟 IC 学习、写作与知识整理工作台",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "prettier --check server shared src tests scripts/test-reliability-ui.mjs scripts/demo.mjs",
    "typecheck": "tsc --noEmit",
    "demo": "node --import tsx scripts/demo.mjs",
    "test:reliability-ui": "node --import tsx scripts/test-reliability-ui.mjs",
    "dev": "node --import tsx scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:ui": "node scripts/test-ui.mjs",
    "test:sidebar-subfolder": "node scripts/test-sidebar-subfolder.mjs",
    "desktop:pack": "npm run build && electron-builder --dir --publish never",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "plugin:setup": "node scripts/setup-plugin.mjs",
    "plugin:install": "node scripts/setup-plugin.mjs --install",
    "test:mcp": "node --import tsx scripts/test-mcp.mjs",
    "test:panel": "node --import tsx scripts/test-panel.mjs",
    "test:paperdesk": "node --import tsx scripts/test-paperdesk.mjs",
    "test:packaged-paperdesk": "node scripts/test-packaged-paperdesk.mjs",
    "test:codex-host": "node --import tsx scripts/test-codex-host.mjs",
    "test:capture": "node scripts/test-capture.mjs",
    "desktop:pack:win": "npm run build && electron-builder --win --x64 --dir --publish never",
    "desktop:dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "desktop:pack:mac": "npm run build && electron-builder --mac --dir --publish never",
    "desktop:dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.zeen.knowledgeworkbench",
    "productName": "Knowledge Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "!desktop/*.nsh",
      "build/**/*",
      "dist/**/*",
      "plugins/**/*",
      "package.json",
      "!**/*.{sqlite,db,log}",
      ".agents/plugins/marketplace.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "publish": null,
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "artifactName": "KnowledgeWorkbench-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "include": "desktop/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "KnowledgeWorkbench-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "diff": "9.0.0",
    "express": "5.3.0",
    "katex": "0.19.0",
    "lucide-react": "1.54.0",
    "markdown-it": "15.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/express": "5.0.6",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "author": "Zeen-F"
}
